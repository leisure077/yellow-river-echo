# 本项目实际依赖的 Dify 覆盖项（其余全部保持 dify 1.13.2 官方 .env.example 默认值即可）
# 用法：cp .env.example .env，把尖括号那几行换成自己的值；.env 本身绝不入库、绝不进提交包。

# —— 必须自己生成，三处占位符不能照抄 ——
SECRET_KEY=<openssl rand -base64 42 生成，换了旧数据解不开>
DB_PASSWORD=<自定义数据库口令>
CELERY_BROKER_URL=redis://:<与 REDIS 口令一致>@redis:6379/1
CELERY_BACKEND=redis

# —— 本机实测在用的关键项（值就是当前部署里跑出来的）——
MIGRATION_ENABLED=true
VECTOR_STORE=weaviate
STORAGE_TYPE=opendal
DB_TYPE=postgresql
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify
DB_USERNAME=postgres
REDIS_HOST=redis
REDIS_PORT=6379

# 网关：只对外发布 80/443，数据库与向量库不发布端口（本机实测端口映射只有这两条 + 插件调试 5003）
EXPOSE_NGINX_PORT=80
EXPOSE_NGINX_SSL_PORT=443
NGINX_PORT=80
NGINX_HTTPS_ENABLED=false

# 服务端并发与超时：这几项直接决定 App 侧「首字多久、多久算卡死」
SERVER_WORKER_CLASS=gevent
SERVER_WORKER_AMOUNT=1
SERVER_WORKER_CONNECTIONS=10
GUNICORN_TIMEOUT=360
TEXT_GENERATION_TIMEOUT_MS=60000
API_TOOL_DEFAULT_CONNECT_TIMEOUT=10
API_TOOL_DEFAULT_READ_TIMEOUT=60
PLUGIN_DAEMON_TIMEOUT=600.0

# 沙箱与 SSRF 代理走容器内网，默认即可，列出来是为了排错时知道去哪看
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
SSRF_PROXY_HTTP_URL=http://ssrf_proxy:3128
SSRF_PROXY_HTTPS_URL=http://ssrf_proxy:3128

# —— 遥测与外呼：本机实测保持官方默认（CHECK_UPDATE_URL 指向 updates.dify.ai）——
# 演示机若在一个不通外网的隔离网里，可以按下面两行把更新检查与遥测关掉。
CHECK_UPDATE_URL=https://updates.dify.ai
SCARF_NO_ANALYTICS=true
ENABLE_REQUEST_LOGGING=False
